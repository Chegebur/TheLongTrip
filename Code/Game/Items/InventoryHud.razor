@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace LongTrip.Gameplay

<root>
	<div class="overlay @(Open ? "" : "hidden")">

		<div @ref="_dialog" class="window">

			<div class="titlebar">
				<div class="title">INVENTORY</div>
				<div style="display: flex; flex-direction: row; align-items: center;">
					<div class="hint">Tab to close</div>
					<div class="close" onclick=@Close>X</div>
				</div>
			</div>

			<div class="body">

				@* ---- equipment, the character, pockets and packs ---- *@
				<div class="top">

					<div class="col" style="width: 84px; flex-shrink: 0;">
						<div class="caption">WORN</div>
						<div class="slots">
							@for ( int a = 0; a < 4; a++ )
							{
								int armor = a;
								var worn = Inv?.Armor[armor];
								var pic = IconOf( worn );
								<div class="slot" slotid="arm:@armor" onmousedown=@(() => BeginDrag( "arm", armor )) onmouseup=@FinishDrag onmouseover=@(() => Hover( "arm", armor )) onmouseout=@Unhover onrightclick=@(() => RightClick( "arm", armor )) style="@Rarity.SlotLook( worn?.ItemId )">
									<div class="hl"></div>
									@if ( worn is null )
									{
										<div class="tag">@(new[] { "HEAD", "BODY", "LEGS", "FEET" }[armor])</div>
									}
									else if ( pic is not null )
									{
										<Image class="icon" Texture=@pic />
									}
								</div>
							}
						</div>
					</div>

					<div class="character" onmousedown=@StartSpin>
						<ScenePanel @ref="_charPanel" class="scene" />
						<div class="note">DRAG TO TURN</div>
					</div>

					<div class="col" style="flex-grow: 1;">
						<div class="caption">CARRIED</div>
						<div class="slots">
							@for ( int row = 0; row < 4; row++ )
							{
								int r = row;
								<div class="packrow">
									<div class="rowlabel @(Unlocked( r * 4 ) ? "" : "off")">@(new[] { "Pockets", "Small pack", "Medium pack", "Large pack" }[r])</div>
									@for ( int col = 0; col < 4; col++ )
									{
										int idx = r * 4 + col;
										bool open = Unlocked( idx );
										var stored = Inv?.Storage[idx];
										var pic = IconOf( stored );
										<div class="slot @(open ? "" : "locked")" slotid="bag:@idx" onmousedown=@(() => BeginDrag( "bag", idx )) onmouseup=@FinishDrag onmouseover=@(() => Hover( "bag", idx )) onmouseout=@Unhover onrightclick=@(() => RightClick( "bag", idx )) style="@Rarity.SlotLook( open ? stored?.ItemId : null, open )">
											<div class="hl"></div>
											@if ( !open )
											{
												<div class="tag">LOCKED</div>
											}
											else if ( stored is not null && pic is not null )
											{
												<Image class="icon" Texture=@pic />
											}
										</div>
									}
								</div>
							}
						</div>
					</div>
				</div>

				@* ---- pocket crafting ---- *@
				<div class="crafting">
					<div class="recipes">
						<div class="caption">POCKET CRAFTING</div>
						<div class="grid">
							@for ( int i = 0; i < Recipes.Count; i++ )
							{
								int recipe = i;
								bool can = CanCraft( Recipes[recipe] );
								int rarity = Rarity.Of( Recipes[recipe].Output );
								var pic = ItemIcons.Icon( Recipes[recipe].Output );
								<div class="recipe" onclick=@(() => SelectRecipe( recipe )) style="background-image: radial-gradient(circle, @Rarity.Css( rarity, recipe == _recipe ? 0.34f : 0.14f ) 0%, @Rarity.Css( rarity, 0.03f ) 85%); border: 2px solid @Rarity.Css( rarity, recipe == _recipe ? 0.95f : 0.25f ); opacity: @(can ? "1" : "0.55");">
									@if ( pic is not null ) { <Image class="pic" Texture=@pic /> }
									<div class="name">@Recipes[recipe].Name</div>
								</div>
							}
						</div>
					</div>

					<div class="detail">
						<div style="display: flex; flex-direction: column; flex-shrink: 0;">
							<div class="preview">
								<ScenePanel @ref="_recipePanel" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%;" />
							</div>
							<div class="craftbtn @(SelectedCanCraft ? "ready" : "")" onclick=@Craft>CRAFT</div>
						</div>
						<div class="info">
							@if ( Selected is not null )
							{
								<div class="name" style="color: @Rarity.Css( Rarity.Of( Selected.Output ), 1f );">@Selected.Name@(Selected.OutputCount > 1 ? $" x{Selected.OutputCount}" : "")</div>
								<div class="desc">@Selected.Description</div>
								<div class="needs">NEEDS</div>
								@foreach ( var (item, count) in Selected.Inputs )
								{
									int have = Inv?.Count( item ) ?? 0;
									<div class="need @(have >= count ? "" : "missing")">@count x @(ItemLibrary.Get( item )?.Name ?? item)  (@have)</div>
								}
							}
							else
							{
								<div class="desc">No recipes</div>
							}
						</div>
					</div>
				</div>

				@* ---- the hotbar ---- *@
				<div class="hotbar">
					<div class="caption" style="margin-left: 6px;">HOTBAR</div>
					<div class="row">
						@for ( int h = 0; h < 6; h++ )
						{
							int slot = h;
							var hot = Inv?.Hotbar?.Get( slot );
							var pic = IconOf( hot );
							<div class="slot @(slot == HotSelected ? "selected" : "")" slotid="hot:@slot" onmousedown=@(() => BeginDrag( "hot", slot )) onmouseup=@FinishDrag onmouseover=@(() => Hover( "hot", slot )) onmouseout=@Unhover onrightclick=@(() => RightClick( "hot", slot )) style="@Rarity.SlotLook( hot?.ItemId )">
								<div class="hl"></div>
								<div class="num">@(slot + 1)</div>
								@if ( hot is not null && pic is not null )
								{
									<Image class="icon" Texture=@pic />
								}
								else if ( hot is null && slot == HeldSlot )
								{
									<div class="tag">IN HAND</div>
								}
							</div>
						}
					</div>
				</div>
			</div>
		</div>

		@* ---- status ---- *@
		<div class="status">
			<div class="caption">STATUS</div>
			@foreach ( var (label, value, color) in Bars() )
			{
				<div class="bar">
					<div class="label">@label</div>
					<div class="track"><div class="fill" style="width: @((int)Math.Clamp( value, 0f, 100f ))%; background-color: @color;"></div></div>
					<div class="value">@((int)value)</div>
				</div>
			}
			<div class="sep"></div>
			<div class="caption">ARMOR</div>
			<div class="row">@((int)((1f - (Inv?.DamageFactor ?? 1f)) * 100f))% less damage taken</div>
			<div class="sep"></div>
			<div class="caption">WORLD</div>
			@if ( Info is not null )
			{
				@foreach ( var line in Info )
				{
					<div class="row">@line</div>
				}
			}
			<div class="help">Drag items between slots. Hover for details. Right click sends an item to the other bar or puts armor on.</div>
		</div>

		@* ---- the item on the cursor (moved every frame by code) ---- *@
		<div @ref="_dragPanel" class="dragging" style="display: @(_cursor is not null ? "flex" : "none");">
			@{ var dragPic = IconOf( _cursor ); }
			@if ( dragPic is not null ) { <Image Texture=@dragPic style="width: 68px; height: 68px;" /> }
		</div>

		@* ---- the hover menu ---- *@
		<div @ref="_tipPanel" class="tip" style="display: @(TipVisible ? "flex" : "none"); border-color: @Rarity.Css( TipRarity, 0.75f ); box-shadow: 0 0 22px @Rarity.Css( TipRarity, 0.30f );">
			<div class="t-name" style="color: @Rarity.Css( TipRarity, 1f );">@TipName</div>
			<div class="t-sub">@TipSubtitle</div>
			@if ( !string.IsNullOrEmpty( TipDescription ) )
			{
				<div class="t-desc">@TipDescription</div>
			}
			@foreach ( var line in TipLines )
			{
				<div class="t-line">@line</div>
			}
			@if ( !string.IsNullOrEmpty( TipHint ) )
			{
				<div class="t-hint">@TipHint</div>
			}
		</div>
	</div>
</root>

@code
{
	public static bool IsOpen { get; private set; }

	public bool Open { get; private set; }

	/// <summary>Filled by the grabber each frame: the hotbar slot that is selected and the one whose item is in your hands.</summary>
	public int HotSelected { get; set; }
	public int HeldSlot { get; set; } = -1;
	public string[] Info { get; set; }

	private PlayerInventory Inv => PlayerInventory.Instance;
	private PlayerStats Stats => Scene.GetAllComponents<PlayerStats>().FirstOrDefault();

	private ItemContainer.Stored _cursor;
	private Panel _dragPanel, _tipPanel;
	private ItemContainer.Stored _hovered;
	private string _tipName, _tipSubtitle, _tipDescription, _tipHint;
	private int _tipRarity;
	private List<string> _tipLines = new();
	private int _recipe;
	private int _version;

	// the two 3D previews
	private ScenePanel _charPanel, _recipePanel;
	private GameObject _charRoot, _charCamera, _recipeRoot, _recipeCamera;
	private CameraComponent _charCam, _recipeCam;
	private string _recipeShown;
	private bool _spinning;
	private float _spinFrom;
	private float _charYaw = 20f;
	private bool _scenesReady;
	private string _armorSig = "";
	private float _rebuildAt;
	private float _rebuildAgain;

	private IReadOnlyList<Recipe> Recipes => RecipeLibrary.All;
	private Recipe Selected => _recipe >= 0 && _recipe < Recipes.Count ? Recipes[_recipe] : null;
	private bool SelectedCanCraft => Selected is not null && CanCraft( Selected );

	private bool Unlocked( int storageSlot ) => Inv is not null && Inv.IsUnlocked( storageSlot );

	private static string NameOf( ItemContainer.Stored s ) => ItemLibrary.Get( s.ItemId )?.Name ?? s.ItemId;
	private static bool HasBar( ItemContainer.Stored s ) { var d = ItemLibrary.Get( s.ItemId ); return d is not null && (d.Use is UseKind.Drink or UseKind.Refuel || d.Container is not null || (d.Use == UseKind.Eat && s.Amount < 0.99f)); }

	private IEnumerable<(string, float, string)> Bars()
	{
		var s = Stats;
		yield return ("Health", s?.Health ?? 100f, "rgba(210,70,70,0.95)");
		yield return ("Food", s?.Food ?? 100f, "rgba(225,170,60,0.95)");
		yield return ("Water", s?.Water ?? 100f, "rgba(80,160,230,0.95)");
	}

	// ---- opening and closing -----------------------------------------------------------------------------------------------------

	protected override void OnUpdate()
	{
		if ( Input.Keyboard.Pressed( "tab" ) || (Open && Input.Keyboard.Pressed( "escape" )) ) Toggle();

		if ( !Open ) return;

		Mouse.Visibility = MouseVisibility.Visible;
		PlaceFloatingPanels();

		// drag on the character to turn it
		if ( _spinning )
		{
			if ( Input.Down( "Attack1" ) ) { _charYaw += (Mouse.Position.x - _spinFrom) * 0.6f; _spinFrom = Mouse.Position.x; }
			else _spinning = false;
		}

		UpdateScenes();
	}

	/// <summary>The close button.</summary>
	private void Close() { if ( Open ) Toggle(); }

	private void Toggle()
	{
		Open = !Open;
		IsOpen = Open;
		Sfx.Play( Open ? Sfx.Open : Sfx.Close );
		Mouse.Visibility = Open ? MouseVisibility.Visible : MouseVisibility.Auto;

		if ( Open )
		{
			RecipeLibrary.Reset();
			ItemLibrary.Reset();
			if ( !_scenesReady ) SetUpScenes();
			_recipeShown = null;
		}
		else
		{
			ReturnCursor();
		}
		_version++;
	}

	protected override void OnDisabled() { IsOpen = false; }

	/// <summary>Closing with something on the cursor: it goes back into the inventory, or onto the ground in front of you.</summary>
	private void ReturnCursor()
	{
		if ( _cursor is null ) return;
		var stored = _cursor;
		_cursor = null;
		if ( Inv is not null && Inv.TryAdd( stored ) ) return;
		DropInFront( stored );
	}

	private void DropInFront( ItemContainer.Stored stored )
	{
		var cam = Scene.Camera;
		if ( !cam.IsValid() ) return;
		var item = ItemLibrary.Spawn( Scene, stored.ItemId, cam.WorldPosition + cam.WorldRotation.Forward * 90f, cam.WorldRotation, stored.Amount );
		if ( item.IsValid() && stored.Liquid is not null ) item.Liquid = stored.Liquid;
	}

	// ---- slots ---------------------------------------------------------------------------------------------------------------------

	private ItemContainer.Stored GetSlot( string kind, int i ) => kind switch
	{
		"hot" => Inv?.Hotbar?.Get( i ),
		"bag" => Inv is not null && i < PlayerInventory.MaxStorage ? Inv.Storage[i] : null,
		"arm" => Inv is not null && i < 4 ? Inv.Armor[i] : null,
		_ => null,
	};

	private void SetSlot( string kind, int i, ItemContainer.Stored s )
	{
		if ( Inv is null ) return;
		if ( kind == "hot" ) Inv.Hotbar?.Set( i, s );
		else if ( kind == "bag" ) Inv.Storage[i] = s;
		else if ( kind == "arm" ) Inv.Armor[i] = s;
	}

	private bool Accepts( string kind, int i, ItemContainer.Stored s )
	{
		var def = ItemLibrary.Get( s.ItemId );
		if ( def is null ) return false;
		return kind switch
		{
			"arm" => PlayerInventory.ArmorIndex( s.ItemId ) == i,
			"bag" => Unlocked( i ) && def.Stowable,
			_ => def.Stowable,
		};
	}

	private bool TipVisible => Open && _hovered is not null && _cursor is null;
	private string TipName => _tipName;
	private string TipSubtitle => _tipSubtitle;
	private string TipDescription => _tipDescription;
	private string TipHint => _tipHint;
	private int TipRarity => _tipRarity;
	private List<string> TipLines => _tipLines;

	/// <summary>The dragged item and the hover menu follow the mouse. Moved directly every frame (not through a rebuild) so they never lag, and in the panel's own units so they sit exactly under the pointer at any resolution.</summary>
	private void PlaceFloatingPanels()
	{
		float scale = MathF.Max( 0.01f, Panel.ScaleToScreen );
		var m = Panel.MousePosition / scale;

		if ( _dragPanel is not null )
		{
			_dragPanel.Style.Left = Length.Pixels( m.x - 32f );
			_dragPanel.Style.Top = Length.Pixels( m.y - 32f );
		}

		if ( _tipPanel is not null && TipVisible )
		{
			float width = Panel.Box.Rect.Width / scale;
			float height = Panel.Box.Rect.Height / scale;
			float x = m.x + 24f;
			float y = m.y + 20f;
			if ( x + 280f > width ) x = m.x - 294f;
			if ( y + 230f > height ) y = MathF.Max( 8f, height - 240f );
			_tipPanel.Style.Left = Length.Pixels( x );
			_tipPanel.Style.Top = Length.Pixels( y );
		}
	}

	private void Hover( string kind, int i )
	{
		var s = kind == "bag" && !Unlocked( i ) ? null : GetSlot( kind, i );
		if ( ReferenceEquals( s, _hovered ) ) return;
		_hovered = s;
		if ( s is not null ) BuildTip( s, kind );
		_version++;
	}

	private void Unhover()
	{
		if ( _hovered is null ) return;
		_hovered = null;
		_version++;
	}

	private void BuildTip( ItemContainer.Stored s, string kind )
	{
		var def = ItemLibrary.Get( s.ItemId );
		_tipLines = new List<string>();
		if ( def is null ) { _tipName = s.ItemId; _tipSubtitle = ""; _tipDescription = null; _tipHint = null; _tipRarity = 0; return; }

		_tipName = def.Name;
		_tipRarity = def.Rarity;
		_tipSubtitle = $"{Rarity.NameOf( def.Rarity )} - {def.Category}";
		_tipDescription = def.Description;

		_tipLines.Add( $"{(def.Hands == 1 ? "One-handed" : "Two-handed")}, {def.Mass:0.#} kg" );
		if ( def.Use == UseKind.Melee ) _tipLines.Add( $"Hits for up to {def.Damage.Cap:0} damage (faster swings hit harder)" );
		if ( def.ArmorSlot is not null ) _tipLines.Add( $"Armor: {def.Defense * 100f:0}% less damage ({def.ArmorSlot})" );
		if ( def.BackpackTier > 0 ) _tipLines.Add( $"Backpack: adds {PlayerInventory.SlotsPerTier} slots" );
		if ( def.Use == UseKind.Eat ) _tipLines.Add( $"Restores {def.Restore * s.Amount:0} food" );
		if ( def.Use == UseKind.Drink ) _tipLines.Add( $"Restores up to {def.Restore * s.Amount:0} water ({s.Amount * 100f:0}% left)" );
		if ( def.Use == UseKind.Refuel ) _tipLines.Add( $"Fuel: {s.Amount * def.Capacity:0} / {def.Capacity:0} L" );
		if ( def.Container is { } c ) _tipLines.Add( s.Amount > 0.01f ? $"Holds {s.Amount * c.Capacity:0} / {c.Capacity:0} L of {s.Liquid}" : $"Empty ({c.Capacity:0} L)" );
		if ( def.Explosion is not null ) _tipLines.Add( "Explodes when hit hard enough" );

		_tipHint = def.ArmorSlot is not null || def.BackpackTier > 0 ? "Drag to move. Right click to wear." : kind == "hot" ? "Drag to move. Right click: to pockets." : "Drag to move. Right click: to hotbar.";
	}

	private Panel _dialog;

	/// <summary>
	/// The mouse was let go. The button goes up on the slot it was pressed on (the panel keeps the mouse), so the slot under the pointer is found
	/// by position: every slot has a slotid ("kind:index"). Over a slot: drop there. Over the window: back where it came from. Outside: into the world.
	/// </summary>
	private void FinishDrag()
	{
		if ( _cursor is null ) return;

		var mouse = Panel.MousePosition + Panel.Box.Rect.Position;   // screen pixels, like every Box.Rect
		foreach ( var slot in AllPanels( Panel ) )
		{
			string id = slot.GetAttribute( "slotid", null );
			if ( id is null || !slot.Box.Rect.IsInside( mouse ) ) continue;

			int colon = id.IndexOf( ':' );
			if ( colon > 0 && int.TryParse( id.Substring( colon + 1 ), out int index ) )
			{
				EndDrag( id.Substring( 0, colon ), index );
				return;
			}
		}

		if ( _dialog is not null && _dialog.Box.Rect.IsInside( mouse ) ) DropInside();
		else DropOutside();
	}

	private static IEnumerable<Panel> AllPanels( Panel root )
	{
		foreach ( var child in root.Children )
		{
			yield return child;
			foreach ( var deeper in AllPanels( child ) ) yield return deeper;
		}
	}

	private string _dragKind;
	private int _dragIndex;

	private Texture IconOf( ItemContainer.Stored s ) => s is null ? null : ItemIcons.Icon( s.ItemId );

	/// <summary>Mouse down on a slot with something in it: pick it up (it follows the mouse until you let go).</summary>
	private void BeginDrag( string kind, int i )
	{
		if ( Inv is null || _cursor is not null ) return;
		if ( kind == "bag" && !Unlocked( i ) ) return;

		var here = GetSlot( kind, i );
		if ( here is null ) return;

		_cursor = here;
		_dragKind = kind;
		_dragIndex = i;
		SetSlot( kind, i, null );
		Sfx.Play( Sfx.DragStart );
		_version++;
	}

	/// <summary>Mouse up on a slot: put what you are carrying there (swapping with what was there); if it does not fit it goes back.</summary>
	private void EndDrag( string kind, int i )
	{
		if ( _cursor is null || Inv is null ) return;

		if ( !Accepts( kind, i, _cursor ) || (kind == "bag" && !Unlocked( i )) )
		{
			Sfx.Play( Sfx.Deny );
			PlayerGrabber.Instance?.Notify( kind == "arm" ? "That does not go there" : "It does not fit" );
			ReturnToOrigin();
			return;
		}

		var old = GetSlot( kind, i );
		SetSlot( kind, i, _cursor );
		_cursor = null;

		// what was there goes to the slot the dragged item came from, if it can; otherwise wherever there is room
		if ( old is not null )
		{
			if ( Accepts( _dragKind, _dragIndex, old ) && GetSlot( _dragKind, _dragIndex ) is null ) SetSlot( _dragKind, _dragIndex, old );
			else if ( !Inv.TryAdd( old ) ) DropInFront( old );
		}
		Sfx.Play( kind == "arm" ? Sfx.Cloth : Sfx.DragStop );
		_version++;
	}

	/// <summary>Let go on the inventory's own background: back where it came from.</summary>
	private void DropInside()
	{
		if ( _cursor is null ) return;
		ReturnToOrigin();
	}

	/// <summary>Let go on the dark area around the inventory: it is thrown into the world in front of you.</summary>
	private void DropOutside()
	{
		if ( _cursor is null ) return;
		var stored = _cursor;
		_cursor = null;
		DropInFront( stored );
		Sfx.Play( Sfx.DragStop );
		_version++;
	}

	private void ReturnToOrigin()
	{
		var stored = _cursor;
		_cursor = null;
		if ( stored is null || Inv is null ) return;
		if ( GetSlot( _dragKind, _dragIndex ) is null && Accepts( _dragKind, _dragIndex, stored ) ) SetSlot( _dragKind, _dragIndex, stored );
		else if ( !Inv.TryAdd( stored ) ) DropInFront( stored );
		_version++;
	}

	private void RightClick( string kind, int i )
	{
		if ( Inv is null || _cursor is not null ) return;
		var here = GetSlot( kind, i );
		if ( here is null ) return;

		bool moved;
		if ( kind == "arm" ) moved = Inv.TryAdd( here );
		else if ( PlayerInventory.ArmorIndex( here.ItemId ) >= 0 ) { SetSlot( kind, i, null ); moved = Inv.Wear( here ); if ( !moved ) SetSlot( kind, i, here ); }
		else if ( kind == "hot" ) moved = Inv.TryAddStorage( here );
		else { int free = Inv.Hotbar?.FirstFree() ?? -1; moved = free >= 0; if ( moved ) Inv.Hotbar.Set( free, here ); }

		if ( moved && kind != "arm" && PlayerInventory.ArmorIndex( here.ItemId ) < 0 ) SetSlot( kind, i, null );
		else if ( moved && kind == "arm" ) SetSlot( kind, i, null );
		_version++;
	}

	// ---- crafting ------------------------------------------------------------------------------------------------------------------

	private void SelectRecipe( int i ) { _recipe = i; Sfx.Play( Sfx.Press ); _version++; }

	private bool CanCraft( Recipe r ) => Inv is not null && r.Inputs.All( x => Inv.Count( x.Item ) >= x.Count );

	private void Craft()
	{
		var r = Selected;
		if ( r is null || Inv is null ) return;
		if ( !CanCraft( r ) ) { Sfx.Play( Sfx.Deny ); return; }

		foreach ( var (item, count) in r.Inputs ) Inv.Consume( item, count );

		var def = ItemLibrary.Get( r.Output );
		for ( int n = 0; n < r.OutputCount; n++ )
		{
			var made = new ItemContainer.Stored( r.Output, def?.Container?.StartFill ?? 1f, def?.Container?.StartFill > 0f ? def.Container.Liquid : null );
			if ( def is not null && def.Stowable && Inv.TryAdd( made ) ) continue;
			DropInFront( made );
		}
		Sfx.Play( Sfx.Craft );
		PlayerGrabber.Instance?.Notify( $"Crafted {r.Name}" );
		_version++;
	}

	// ---- the 3D previews ---------------------------------------------------------------------------------------------------------------

	private void StartSpin() { _spinning = true; _spinFrom = Mouse.Position.x; }

	private static void Build( ScenePanel panel, out GameObject root, out GameObject camera, out CameraComponent cam )
	{
		var scene = panel.RenderScene;
		camera = scene.CreateObject();
		cam = camera.Components.Create<CameraComponent>();
		cam.BackgroundColor = new Color( 0.06f, 0.07f, 0.09f, 1f );
		cam.FieldOfView = 30f;
		cam.ZNear = 1f;
		cam.ZFar = 2000f;

		var sun = scene.CreateObject();
		sun.WorldRotation = Rotation.From( 45f, -35f, 0f );
		sun.Components.Create<DirectionalLight>().LightColor = Color.White * 2.4f;
		var fill = scene.CreateObject();
		fill.Components.Create<AmbientLight>().Color = new Color( 0.5f, 0.52f, 0.58f );

		root = scene.CreateObject();
	}

	private void SetUpScenes()
	{
		if ( _charPanel is null || _recipePanel is null ) return;
		_scenesReady = true;

		Build( _charPanel, out _charRoot, out _charCamera, out _charCam );
		Build( _recipePanel, out _recipeRoot, out _recipeCamera, out _recipeCam );

		BuildCharacter();

		_charCamera.WorldPosition = new Vector3( 150f, 0f, 37f );
		_charCamera.WorldRotation = Rotation.LookAt( new Vector3( -1f, 0f, 0f ) );
	}

	/// <summary>Copy the player's model and what it wears into the preview (again whenever the armor changes).</summary>
	private void BuildCharacter()
	{
		if ( !_scenesReady ) return;
		foreach ( var child in _charRoot.Children.ToList() ) child.Destroy();

				var player = Scene.GetAllObjects( true ).FirstOrDefault( g => g.Components.Get<PlayerController>( true ) is not null );
		var source = player?.Components.Get<PlayerController>( true )?.Renderer ?? player?.Components.Get<SkinnedModelRenderer>( FindMode.EverythingInSelfAndDescendants );
		if ( source.IsValid() && source.Model is not null )
		{
			var body = _charRoot.Scene.CreateObject();
			body.Parent = _charRoot;
			var bodyRenderer = body.Components.Create<SkinnedModelRenderer>();
			bodyRenderer.Model = source.Model;
			bodyRenderer.Tint = source.Tint;
			bodyRenderer.MaterialGroup = source.MaterialGroup;

			foreach ( var piece in source.GameObject.Children )
			{
				var from = piece.Components.Get<SkinnedModelRenderer>( true );
				if ( !from.IsValid() || from.Model is null ) continue;
				var clone = _charRoot.Scene.CreateObject();
				clone.Parent = body;
				var r = clone.Components.Create<SkinnedModelRenderer>();
				r.Model = from.Model;
				r.Tint = from.Tint;
				r.MaterialGroup = from.MaterialGroup;
				r.BoneMergeTarget = bodyRenderer;
			}
		}

	}

	private void UpdateScenes()
	{
		if ( !_scenesReady ) return;

		string armorSig = Inv is null ? "" : string.Join( ',', Inv.Armor.Select( a => a?.ItemId ?? "-" ) );
		if ( armorSig != _armorSig ) { _armorSig = armorSig; _rebuildAt = RealTime.Now + 0.6f; _rebuildAgain = RealTime.Now + 2.5f; }
		if ( _rebuildAgain > 0f && RealTime.Now >= _rebuildAgain ) { _rebuildAgain = 0f; BuildCharacter(); }
		if ( _rebuildAt > 0f && RealTime.Now >= _rebuildAt ) { _rebuildAt = 0f; BuildCharacter(); }

		_charRoot.WorldRotation = Rotation.FromYaw( _charYaw );
		FitCamera( _charPanel, _charCam );
		FitCamera( _recipePanel, _recipeCam );

		// the recipe's result, turning slowly about the vertical axis
		var recipe = Selected;
		if ( recipe?.Id != _recipeShown )
		{
			_recipeShown = recipe?.Id;
			foreach ( var child in _recipeRoot.Children.ToList() ) child.Destroy();

			var def = recipe is null ? null : ItemLibrary.Get( recipe.Output );
			var model = def is null ? null : ItemLibrary.GetModel( def );
			if ( model.IsValid() )
			{
				float scale = def.ModelScale;
				var go = _recipeRoot.Scene.CreateObject();
				go.Parent = _recipeRoot;
				go.LocalPosition = -model.Bounds.Center * scale;
				go.LocalScale = Vector3.One * scale;
				go.Components.Create<ModelRenderer>().Model = model;

				float size = MathF.Max( 4f, model.Bounds.Size.Length * scale );
				_recipeCamera.WorldPosition = new Vector3( size * 2.1f, 0f, size * 0.35f );
				_recipeCamera.WorldRotation = Rotation.LookAt( -_recipeCamera.WorldPosition );
			}
		}
		_recipeRoot.WorldRotation = Rotation.FromYaw( RealTime.Now * 24f );
	}

	private static void FitCamera( ScenePanel panel, CameraComponent cam )
	{
		if ( panel is null || !cam.IsValid() ) return;
		var size = panel.Box.RectInner.Size;
		if ( size.x > 1f && size.y > 1f ) cam.CustomSize = size;
	}

	protected override int BuildHash()
	{
		var hash = new System.HashCode();
		hash.Add( Open ); hash.Add( _version ); hash.Add( _recipe ); hash.Add( HotSelected ); hash.Add( HeldSlot );
		if ( Open )
		{
			hash.Add( Info is null ? "" : string.Join( '|', Info ) );
			var s = Stats;
			if ( s is not null ) { hash.Add( (int)s.Health ); hash.Add( (int)s.Food ); hash.Add( (int)s.Water ); }
			hash.Add( _cursor is not null );
			hash.Add( _hovered );
			var inv = Inv;
			if ( inv is not null )
			{
				hash.Add( inv.BackpackTier );
				for ( int i = 0; i < inv.Storage.Length; i++ ) hash.Add( inv.Storage[i] );
				for ( int i = 0; i < inv.Armor.Length; i++ ) hash.Add( inv.Armor[i] );
				for ( int i = 0; inv.Hotbar is not null && i < inv.Hotbar.Slots.Count; i++ ) hash.Add( inv.Hotbar.Get( i ) );
			}
		}
		return hash.ToHashCode();
	}
}
