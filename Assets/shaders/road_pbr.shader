HEADER
{
	Description = "Road - asphalt PBR with painted lines in vertex colour (generated by gen_shaders.py)";
	Version = 1;
}

FEATURES
{
	#include "common/features.hlsl"
}

MODES
{
	Forward();
	Depth();
}

COMMON
{
	#include "common/shared.hlsl"
}

struct VertexInput
{
	#include "common/vertexinput.hlsl"
	// rgb = paint colour (sRGB), a = paint amount (0 = bare asphalt)
	float4 vPaint : COLOR0 < Semantic( Color ); >;
};

struct PixelInput
{
	#include "common/pixelinput.hlsl"
};

VS
{
	#include "common/vertex.hlsl"

	PixelInput MainVs( VertexInput i )
	{
		PixelInput o = ProcessVertex( i );
		o.vVertexColor = i.vPaint;
		return FinalizeVertex( o );
	}
}

PS
{
	#include "common/pixel.hlsl"

	float g_flPaintWear < UiGroup( "Road,5/10" ); Default( 0.5 ); Range( 0.0, 1.0 ); >;

	CreateInputTexture2D( TextureColor_Road0, Srgb, 8, "", "_color", "Layer 0,10/10", Default3( 1.0, 1.0, 1.0 ) );
	CreateInputTexture2D( TextureNormal_Road0, Linear, 8, "NormalizeNormals", "_normal", "Layer 0,10/20", Default3( 0.5, 0.5, 1.0 ) );
	CreateInputTexture2D( TextureRoughness_Road0, Linear, 8, "Inverse", "_rough", "Layer 0,10/30", Default3( 0.5, 0.5, 0.5 ) );
	CreateInputTexture2D( TextureHeight_Road0, Linear, 8, "", "_height", "Layer 0,10/40", Default( 0.5 ) );
	Texture2D g_tColor_Road0 < Channel( RGB, Box( TextureColor_Road0 ), Srgb ); Channel( A, Box( TextureHeight_Road0 ), Linear ); OutputFormat( BC7 ); SrgbRead( true ); >;
	Texture2D g_tNormal_Road0 < Channel( RGBA, HemiOctIsoRoughness_RG_B( TextureNormal_Road0, TextureRoughness_Road0 ), Linear ); OutputFormat( BC7 ); SrgbRead( false ); >;
	CreateInputTexture2D( TextureColor_Road1, Srgb, 8, "", "_color", "Layer 1,10/10", Default3( 1.0, 1.0, 1.0 ) );
	CreateInputTexture2D( TextureNormal_Road1, Linear, 8, "NormalizeNormals", "_normal", "Layer 1,10/20", Default3( 0.5, 0.5, 1.0 ) );
	CreateInputTexture2D( TextureRoughness_Road1, Linear, 8, "Inverse", "_rough", "Layer 1,10/30", Default3( 0.5, 0.5, 0.5 ) );
	CreateInputTexture2D( TextureHeight_Road1, Linear, 8, "", "_height", "Layer 1,10/40", Default( 0.5 ) );
	Texture2D g_tColor_Road1 < Channel( RGB, Box( TextureColor_Road1 ), Srgb ); Channel( A, Box( TextureHeight_Road1 ), Linear ); OutputFormat( BC7 ); SrgbRead( true ); >;
	Texture2D g_tNormal_Road1 < Channel( RGBA, HemiOctIsoRoughness_RG_B( TextureNormal_Road1, TextureRoughness_Road1 ), Linear ); OutputFormat( BC7 ); SrgbRead( false ); >;

	// Gradient (Perlin) noise. Value noise has grid-aligned contours that read as a checkerboard,
	// so everything here uses random gradients and rotates each octave.
	float2 Hash22( float2 p )
	{
		p = float2( dot( p, float2( 127.1, 311.7 ) ), dot( p, float2( 269.5, 183.3 ) ) );
		return -1.0 + 2.0 * frac( sin( p ) * 43758.5453 );
	}

	float GNoise( float2 p )
	{
		float2 ip = floor( p );
		float2 fp = frac( p );
		float2 u = fp * fp * fp * ( fp * ( fp * 6.0 - 15.0 ) + 10.0 );
		float a = dot( Hash22( ip ), fp );
		float b = dot( Hash22( ip + float2( 1, 0 ) ), fp - float2( 1, 0 ) );
		float c = dot( Hash22( ip + float2( 0, 1 ) ), fp - float2( 0, 1 ) );
		float d = dot( Hash22( ip + float2( 1, 1 ) ), fp - float2( 1, 1 ) );
		return lerp( lerp( a, b, u.x ), lerp( c, d, u.x ), u.y ) * 1.4;
	}

	// 3 octaves, each rotated ~37 degrees so no axis lines up. Roughly -1..1.
	float GFbm( float2 p )
	{
		float sum = 0.0;
		float amp = 0.5;
		for ( int o = 0; o < 3; o++ )
		{
			sum += GNoise( p ) * amp;
			p = float2( 0.8 * p.x - 0.6 * p.y, 0.6 * p.x + 0.8 * p.y ) * 2.03 + 17.1;
			amp *= 0.5;
		}
		return sum / 0.875;
	}

	// Per-pixel data for breaking up texture tiling: two random UV offsets and how to mix them.
	struct TileVar
	{
		float4 offsets;   // xy = offset A, zw = offset B
		float2 mixInfo;   // x = 1 when close enough to bother, y = blend position
	};

	TileVar MakeTileVar( float2 wp, float dist )
	{
		TileVar tv;
		float k = GNoise( wp / 1100.0 ) * 0.5 + 0.5;
		float l = k * 8.0;
		float ia = floor( l );
		tv.offsets = float4( sin( float2( 3.0, 7.0 ) * ia ), sin( float2( 3.0, 7.0 ) * ( ia + 1.0 ) ) );
		tv.mixInfo = float2( dist < 14000.0 ? 1.0 : 0.0, frac( l ) );
		return tv;
	}

	// Tangent-space normals were authored for the unrotated texture; turn them with the UVs.
	float3 RoadNormal( float3 n )
	{
		return float3( -n.y, n.x, n.z );
	}

	float4 MainPs( PixelInput i ) : SV_Target0
	{
		Material m = Material::Init( i );

		float2 wp = m.WorldPosition.xy;
		float2 dx = ddx( i.vPositionWithOffsetWs.xy );
		float2 dy = ddy( i.vPositionWithOffsetWs.xy );

		// Rotate the texture 90 degrees so its long cracks run along the lane instead of across it.
		float2 ruv = float2( wp.y, -wp.x );
		float2 rdx = float2( dx.y, -dx.x );
		float2 rdy = float2( dy.y, -dy.x );

		float scaleA = 1.0 / 100.0;
		float scaleB = 1.0 / 100.0;
		TileVar tv = MakeTileVar( wp, length( i.vPositionWithOffsetWs ) );

		float2 uvA = ruv * scaleA;
		float2 gxA = rdx * scaleA;
		float2 gyA = rdy * scaleA;
		float4 colA = g_tColor_Road0.SampleGrad( g_sAniso, uvA + tv.offsets.xy, gxA, gyA );
		float4 norA = g_tNormal_Road0.SampleGrad( g_sAniso, uvA + tv.offsets.xy, gxA, gyA );
		[branch]
		if ( tv.mixInfo.x > 0.5 )
		{
			float4 colX = g_tColor_Road0.SampleGrad( g_sAniso, uvA + tv.offsets.zw, gxA, gyA );
			float4 norX = g_tNormal_Road0.SampleGrad( g_sAniso, uvA + tv.offsets.zw, gxA, gyA );
			float mixT = smoothstep( 0.2, 0.8, tv.mixInfo.y - 0.1 * dot( colA.rgb - colX.rgb, float3( 0.33, 0.33, 0.33 ) ) );
			colA = lerp( colA, colX, mixT );
			norA = lerp( norA, norX, mixT );
		}

		float3 albedo = colA.rgb;
		float3 normalTs = RoadNormal( DecodeHemiOctahedronNormal( norA.rg ) );
		float rough = norA.b;
		float height = colA.a;

		// Patched / re-laid asphalt: irregular blotches whose edges are roughened by the asphalt's own height,
		// so they never end in a clean line.
		float repairNoise = GFbm( wp / 650.0 ) * 0.5 + 0.5;
		repairNoise += ( height - 0.5 ) * 0.22;
		float repairMask = saturate( ( repairNoise - 0.60 ) / 0.10 );
		repairMask = repairMask * repairMask * ( 3.0 - 2.0 * repairMask );
		if ( repairMask > 0.01 )
		{
			float4 colB = g_tColor_Road1.SampleGrad( g_sAniso, uvA * ( scaleB / scaleA ), gxA * ( scaleB / scaleA ), gyA * ( scaleB / scaleA ) );
			float4 norB = g_tNormal_Road1.SampleGrad( g_sAniso, uvA * ( scaleB / scaleA ), gxA * ( scaleB / scaleA ), gyA * ( scaleB / scaleA ) );
			float k = repairMask * 0.6;
			albedo = lerp( albedo, colB.rgb * float3( 2.00, 2.00, 2.00 ), k );
			normalTs = lerp( normalTs, RoadNormal( DecodeHemiOctahedronNormal( norB.rg ) ), k );
			rough = lerp( rough, norB.b, k );
		}

		// Painted lines, worn away where the asphalt surface is high.
		float paintAmount = i.vVertexColor.a * saturate( 1.0 - g_flPaintWear * ( 1.0 - height * 1.3 ) );
		float3 paintLinear = SrgbGammaToLinear( i.vVertexColor.rgb );
		albedo = lerp( albedo, paintLinear, paintAmount );
		rough = lerp( rough, 0.55, paintAmount );

		m.Albedo = albedo;
		m.Normal = TransformNormal( normalize( normalTs ), i.vNormalWs, i.vTangentUWs, i.vTangentVWs );
		m.Roughness = rough;
		m.Metalness = 0.0;
		m.AmbientOcclusion = lerp( 0.75, 1.0, saturate( height * 1.4 ) );
		m.Opacity = 1.0;

		return ShadingModelStandard::Shade( m );
	}
}
