HEADER
{
	Description = "Procedural terrain - biome/role splat blended PBR layers (generated by gen_shaders.py)";
	Version = 1;
}

FEATURES
{
	#include "common/features.hlsl"
}

MODES
{
	Forward();
	Depth();
}

