{
	#include "common/shared.hlsl"
}

struct VertexInput
{
	#include "common/vertexinput.hlsl"
	// Biome weights (sum to 1): desert, grasslands, ice plains, spare.
	float4 vBiomeWeights : COLOR0 < Semantic( Color ); >;
};

struct PixelInput
{
	#include "common/pixelinput.hlsl"
};

VS
{
	#include "common/vertex.hlsl"

	PixelInput MainVs( VertexInput i )
	{
		PixelInput o = ProcessVertex( i );

		// vVertexColor   = biome weights
		// vTextureCoords = ( base, alt, slope, shoulder ) role weights
		o.vVertexColor = i.vBiomeWeights;
		o.vTextureCoords = float4( i.vTexCoord, i.vTexCoord2 );
		return FinalizeVertex( o );
	}
}

