	// Gradient (Perlin) noise. Value noise has grid-aligned contours that read as a checkerboard,
	// so everything here uses random gradients and rotates each octave.
	float2 Hash22( float2 p )
	{
		p = float2( dot( p, float2( 127.1, 311.7 ) ), dot( p, float2( 269.5, 183.3 ) ) );
		return -1.0 + 2.0 * frac( sin( p ) * 43758.5453 );
	}

	float GNoise( float2 p )
	{
		float2 ip = floor( p );
		float2 fp = frac( p );
		float2 u = fp * fp * fp * ( fp * ( fp * 6.0 - 15.0 ) + 10.0 );
		float a = dot( Hash22( ip ), fp );
		float b = dot( Hash22( ip + float2( 1, 0 ) ), fp - float2( 1, 0 ) );
		float c = dot( Hash22( ip + float2( 0, 1 ) ), fp - float2( 0, 1 ) );
		float d = dot( Hash22( ip + float2( 1, 1 ) ), fp - float2( 1, 1 ) );
		return lerp( lerp( a, b, u.x ), lerp( c, d, u.x ), u.y ) * 1.4;
	}

	// 3 octaves, each rotated ~37 degrees so no axis lines up. Roughly -1..1.
	float GFbm( float2 p )
	{
		float sum = 0.0;
		float amp = 0.5;
		for ( int o = 0; o < 3; o++ )
		{
			sum += GNoise( p ) * amp;
			p = float2( 0.8 * p.x - 0.6 * p.y, 0.6 * p.x + 0.8 * p.y ) * 2.03 + 17.1;
			amp *= 0.5;
		}
		return sum / 0.875;
	}

	// Per-pixel data for breaking up texture tiling: two random UV offsets and how to mix them.
	struct TileVar
	{
		float4 offsets;   // xy = offset A, zw = offset B
		float2 mixInfo;   // x = 1 when close enough to bother, y = blend position
	};

	TileVar MakeTileVar( float2 wp, float dist )
	{
		TileVar tv;
		float k = GNoise( wp / 1100.0 ) * 0.5 + 0.5;
		float l = k * 8.0;
		float ia = floor( l );
		tv.offsets = float4( sin( float2( 3.0, 7.0 ) * ia ), sin( float2( 3.0, 7.0 ) * ( ia + 1.0 ) ) );
		tv.mixInfo = float2( dist < 14000.0 ? 1.0 : 0.0, frac( l ) );
		return tv;
	}

	struct LayerSample
	{
		float3 albedo;
		float3 normalTs;
		float  rough;
		float  height;
	};

	LayerSample SampleLayer( int id, float2 wp, float2 dx, float2 dy, TileVar tv )
	{
		LayerSample r = (LayerSample)0;
		r.normalTs = float3( 0, 0, 1 );
		switch ( id )
		{
		case 0:
		{
			const float s = 1.0 / 100.0;
			float2 uv = wp * s;
			float2 gx = dx * s;
			float2 gy = dy * s;
			float4 c = g_tColor_T0.SampleGrad( g_sAniso, uv + tv.offsets.xy, gx, gy );
			float4 nn = g_tNormal_T0.SampleGrad( g_sAniso, uv + tv.offsets.xy, gx, gy );
			[branch]
			if ( tv.mixInfo.x > 0.5 )
			{
				float4 cB = g_tColor_T0.SampleGrad( g_sAniso, uv + tv.offsets.zw, gx, gy );
				float4 nB = g_tNormal_T0.SampleGrad( g_sAniso, uv + tv.offsets.zw, gx, gy );
				float mixT = smoothstep( 0.2, 0.8, tv.mixInfo.y - 0.1 * dot( c.rgb - cB.rgb, float3( 0.33, 0.33, 0.33 ) ) );
				c = lerp( c, cB, mixT );
				nn = lerp( nn, nB, mixT );
			}
			r.albedo = c.rgb * float3( 3.200, 2.800, 1.750 );
			r.height = c.a;
			r.normalTs = DecodeHemiOctahedronNormal( nn.rg );
			r.rough = nn.b;
			break;
